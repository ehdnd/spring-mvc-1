###
# 1. 파라미터 전송 기능
GET http://localhost:8080/request-param?
    username=hello &
    age=12

###
# 2. 동일한 파라미터 전송 가능
GET http://localhost:8080/request-param?
    username=hello&
    username=kim&
    age=20

###
# POST HTML FORM
POST http://localhost:8080/request-param
Content-Type: application/x-www-form-urlencoded

username = hello &
age = 20
